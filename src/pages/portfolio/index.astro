---
import PortfolioListing from "../../components/PortfolioListing.astro";
import { eventYear } from "../../lib/events";
import { getEvents } from "../../lib/portfolio";

const events = await getEvents(Astro);
const since = events.length ? eventYear(events[events.length - 1].data) : "2014";
---

<PortfolioListing
  title="Event portfolio"
  description={`${events.length} theatre productions, concerts and live events I've worked on since ${since}.`}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Portfolio", href: "/portfolio" },
  ]}
  events={events}
/>
