---
import { getSiteSettings } from "emdash";
import { RecentWork } from "../components/EventGrid";
import { HomeHero } from "../components/HomeHero";
import { RecentProjects } from "../components/ProjectGrid";
import Base from "../layouts/Base.astro";
import { getEvents, toEventCards } from "../lib/portfolio";
import { getProjects, toProjectCards } from "../lib/projects";
import { siteImage } from "../lib/siteImages";
import { socialLinks } from "../lib/site";
import { person } from "../lib/structuredData";

export const prerender = true;

const settings = await getSiteSettings();
const name = settings.title || "James Bithell";
const siteUrl = (settings.url || Astro.url.origin).replace(/\/$/, "");
const links = socialLinks(settings.social);

const events = await getEvents();
const recent = await toEventCards(
  Astro,
  events.filter((event) => event.data.featured_image).slice(0, 6)
);

const projects = await getProjects();
const recentProjects = await toProjectCards(Astro, projects.slice(0, 6));

const profile = siteImage("james-bithell-profile.jpg", "140px", `Profile photo of ${name} smiling`);
const background = siteImage("backgrounds/wales3.jpg", "100vw");
---

<Base
  description={`${name}, based in London, United Kingdom. Contact details, CV, development portfolio and an Event Portfolio of ${events.length} live events worked on since 2014.`}
  imageAlt={profile.alt}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      mainEntity: person({
        siteUrl,
        name,
        image: siteUrl + profile.og,
        sameAs: [links.linkedin, links.github],
      }),
    },
  ]}
>
  <HomeHero
    name={name}
    tagline={settings.tagline}
    profile={profile}
    background={background}
    links={links}
  />
  {recentProjects.length > 0 && (
    <RecentProjects
      projects={recentProjects}
      more={{ href: "/projects", label: `All ${projects.length} projects` }}
    />
  )}
  <RecentWork
    events={recent}
    more={{ href: "/portfolio", label: `All ${events.length} events` }}
  />
</Base>
