---
import PortfolioListing from "../../../components/PortfolioListing.astro";
import { getEvents, getTerms } from "../../../lib/portfolio";

export const prerender = true;

export async function getStaticPaths() {
  const terms = await getTerms("role");
  return terms
    .filter((term) => term.count)
    .map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

interface Props {
  term: Awaited<ReturnType<typeof getTerms>>[number];
}

const { term } = Astro.props;
const events = await getEvents({ taxonomy: "role", term: term.slug });
---

<PortfolioListing
  title={term.label}
  description={`Events in James Bithell's Event Portfolio with the role ${term.label}`}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Event Portfolio", href: "/portfolio" },
    { label: term.label, href: `/portfolio/role/${term.slug}` },
  ]}
  events={events}
/>
