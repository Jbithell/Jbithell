---
import PortfolioListing from "../../../components/PortfolioListing.astro";
import { getEvents, getTerms } from "../../../lib/portfolio";

export const prerender = true;

export async function getStaticPaths() {
  const terms = await getTerms("discipline");
  return terms
    .filter((term) => term.count)
    .map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

interface Props {
  term: Awaited<ReturnType<typeof getTerms>>[number];
}

const { term } = Astro.props;
const events = await getEvents({ taxonomy: "discipline", term: term.slug });
---

<PortfolioListing
  title={`Event Portfolio: ${term.label}`}
  description={`${term.label} in James Bithell's Event Portfolio - theatre, concerts and events worked on since 2014`}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Event Portfolio", href: "/portfolio" },
    { label: term.label, href: `/portfolio/discipline/${term.slug}` },
  ]}
  events={events}
  discipline={term.slug}
/>
