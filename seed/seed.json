{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "defaultLocale": "en",
  "meta": {
    "name": "James Bithell",
    "description": "Personal site and live events portfolio of James Bithell",
    "author": "James Bithell"
  },
  "settings": {
    "title": "James Bithell",
    "tagline": "London, United Kingdom",
    "timezone": "Europe/London",
    "dateFormat": "d MMMM yyyy",
    "social": {
      "github": "jbithell",
      "linkedin": "jbithell",
      "facebook": "bithellj"
    },
    "seo": {
      "titleSeparator": " | "
    }
  },
  "collections": [
    {
      "slug": "events",
      "label": "Events",
      "labelSingular": "Event",
      "description": "Event Portfolio: theatre, concerts and other events worked on",
      "icon": "mask-happy",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "urlPattern": "/portfolio/{slug}",
      "titleField": "title",
      "dateField": "date",
      "admin": {
        "listColumns": [
          "date",
          "venue"
        ]
      },
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "date",
          "label": "Date",
          "type": "datetime",
          "required": true,
          "indexed": true
        },
        {
          "slug": "date_precision",
          "label": "Date precision",
          "type": "select",
          "required": true,
          "defaultValue": "day",
          "validation": {
            "options": [
              "day",
              "month",
              "year"
            ]
          }
        },
        {
          "slug": "end_date",
          "label": "End date",
          "type": "datetime"
        },
        {
          "slug": "venue",
          "label": "Venue",
          "type": "string",
          "searchable": true
        },
        {
          "slug": "client",
          "label": "Client",
          "type": "string",
          "searchable": true
        },
        {
          "slug": "director",
          "label": "Directed by",
          "type": "string",
          "searchable": true
        },
        {
          "slug": "author",
          "label": "Written by",
          "type": "string",
          "searchable": true
        },
        {
          "slug": "featured_image",
          "label": "Featured image",
          "type": "image"
        },
        {
          "slug": "image_credit",
          "label": "Image credit",
          "type": "string"
        },
        {
          "slug": "image_credit_url",
          "label": "Image credit link",
          "type": "url"
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "performances_attended",
          "label": "Performances attended",
          "type": "integer",
          "validation": {
            "min": 0
          }
        },
        {
          "slug": "professional",
          "label": "Professional production",
          "type": "boolean",
          "defaultValue": false
        },
        {
          "slug": "paid",
          "label": "Paid work",
          "type": "boolean",
          "defaultValue": false
        }
      ]
    },
    {
      "slug": "projects",
      "label": "Projects",
      "labelSingular": "Project",
      "description": "Projects Portfolio: software and hardware projects",
      "icon": "code",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "urlPattern": "/projects/{slug}",
      "titleField": "title",
      "admin": {
        "listColumns": [
          "sort",
          "language"
        ]
      },
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "summary",
          "label": "Summary",
          "type": "text",
          "searchable": true
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "featured_image",
          "label": "Featured image",
          "type": "image"
        },
        {
          "slug": "repo_url",
          "label": "Repository link",
          "type": "url"
        },
        {
          "slug": "homepage_url",
          "label": "Website link",
          "type": "url"
        },
        {
          "slug": "language",
          "label": "Language",
          "type": "string"
        },
        {
          "slug": "started",
          "label": "Started",
          "type": "datetime"
        },
        {
          "slug": "archived",
          "label": "Archived",
          "type": "boolean",
          "defaultValue": false
