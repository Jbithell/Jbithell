        {
          "slug": "sort",
          "label": "Sort order",
          "type": "integer",
          "required": true,
          "defaultValue": 100,
          "indexed": true
        }
      ]
    },
    {
      "slug": "experience",
      "label": "Experience",
      "labelSingular": "Experience",
      "description": "CV: jobs and volunteering. Public entries show on /cv, private ones only on /cv/private",
      "icon": "briefcase",
      "supports": [
        "drafts",
        "revisions"
      ],
      "titleField": "title",
      "dateField": "start_date",
      "admin": {
        "listColumns": [
          "organisation",
          "start_date",
          "visibility"
        ]
      },
      "fields": [
        {
          "slug": "title",
          "label": "Job title",
          "type": "string",
          "required": true
        },
        {
          "slug": "organisation",
          "label": "Organisation",
          "type": "string",
          "required": true
        },
        {
          "slug": "organisation_url",
          "label": "Organisation link",
          "type": "url"
        },
        {
          "slug": "logo",
          "label": "Organisation logo",
          "type": "image"
        },
        {
          "slug": "section",
          "label": "Section",
          "type": "select",
          "required": true,
          "defaultValue": "work",
          "validation": {
            "options": [
              "work",
              "volunteering"
            ]
          }
        },
        {
          "slug": "employment_type",
          "label": "Employment type",
          "type": "select",
          "validation": {
            "options": [
              "Full-time",
              "Part-time",
              "Self-employed",
              "Freelance",
              "Contract",
              "Internship",
              "Apprenticeship",
              "Seasonal"
            ]
          }
        },
        {
          "slug": "location",
          "label": "Location",
          "type": "string"
        },
        {
          "slug": "start_date",
          "label": "Start date",
          "type": "datetime",
          "required": true,
          "indexed": true
        },
        {
          "slug": "end_date",
          "label": "End date (blank for present)",
          "type": "datetime"
        },
        {
          "slug": "date_precision",
          "label": "Date precision",
          "type": "select",
          "required": true,
          "defaultValue": "month",
          "validation": {
            "options": [
              "month",
              "year"
            ]
          }
        },
        {
          "slug": "visibility",
          "label": "Visibility",
          "type": "select",
          "required": true,
          "defaultValue": "private",
          "validation": {
            "options": [
              "public",
              "private"
            ]
          }
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "portableText"
        },
        {
          "slug": "private_details",
          "label": "Private details",
          "type": "portableText"
        },
        {
          "slug": "projects",
          "label": "Related projects",
          "type": "reference",
          "validation": {
            "relation": "experience_projects"
          }
        }
      ]
    },
