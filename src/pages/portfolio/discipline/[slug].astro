---
import { decodeSlug } from "emdash";
import PortfolioListing from "../../../components/PortfolioListing.astro";
import { getEvents, getTerms } from "../../../lib/portfolio";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? (await getTerms(Astro, "discipline")).find((t) => t.slug === slug) : undefined;
if (!term) return Astro.rewrite("/404");
const events = await getEvents(Astro, { taxonomy: "discipline", term: term.slug });
---

<PortfolioListing
  title={`${term.label} portfolio`}
  description={`${events.length} ${events.length === 1 ? "event" : "events"} I've worked on in ${term.label.toLowerCase()}.`}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Portfolio", href: "/portfolio" },
    { label: term.label, href: `/portfolio/discipline/${term.slug}` },
  ]}
  events={events}
  discipline={term.slug}
/>
