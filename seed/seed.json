        },
        {
          "slug": "visibility",
          "label": "Visibility",
          "type": "select",
          "required": true,
          "defaultValue": "private",
          "validation": {
            "options": [
              "public",
              "private"
            ]
          }
        },
        {
          "slug": "results",
          "label": "Results",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "subject",
                "label": "Subject",
                "type": "string",
                "required": true
              },
              {
                "slug": "grade",
                "label": "Grade",
                "type": "string"
              }
            ]
          }
        },
        {
          "slug": "public_grades",
          "label": "Show grades publicly",
          "type": "boolean",
          "defaultValue": false
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "portableText"
        },
        {
          "slug": "private_details",
          "label": "Private details",
          "type": "portableText"
        }
      ]
    },
    {
      "slug": "cv_share_links",
      "label": "CV Share Links",
      "labelSingular": "CV Share Link",
      "description": "Links that open the private CV at /cv/private. Unpublish or delete a link to revoke it",
      "icon": "link",
      "supports": [
        "drafts"
      ],
      "titleField": "title",
      "admin": {
        "listColumns": [
          "expires"
        ]
      },
      "fields": [
        {
          "slug": "title",
          "label": "Who it's for",
          "type": "string",
          "required": true
        },
        {
          "slug": "key",
          "label": "Key",
          "type": "string",
          "required": true,
          "unique": true,
          "indexed": true,
          "validation": {
            "minLength": 24,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        {
          "slug": "expires",
          "label": "Expires",
          "type": "datetime"
        },
        {
          "slug": "notes",
          "label": "Notes",
          "type": "text"
        }
      ]
    }
