---
import { decodeSlug } from "emdash";
import PortfolioListing from "../../../components/PortfolioListing.astro";
import { getEvents, getTerms } from "../../../lib/portfolio";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? (await getTerms(Astro, "role")).find((t) => t.slug === slug) : undefined;
if (!term) return Astro.rewrite("/404");
const events = await getEvents(Astro, { taxonomy: "role", term: term.slug });
---

<PortfolioListing
  title={term.label}
  description={`Events in James Bithell's Event Portfolio with the role ${term.label}`}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Event Portfolio", href: "/portfolio" },
    { label: term.label, href: `/portfolio/role/${term.slug}` },
  ]}
  events={events}
/>
