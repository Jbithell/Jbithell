---
import PortfolioListing from "../../components/PortfolioListing.astro";
import { eventYear } from "../../lib/events";
import { getEvents } from "../../lib/portfolio";

export const prerender = true;

const events = await getEvents();
const since = events.length ? eventYear(events[events.length - 1].data) : "2014";
---

<PortfolioListing
  title="Event Portfolio"
  description={`James Bithell's Event Portfolio - theatre, concerts and events worked on since ${since}`}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Event Portfolio", href: "/portfolio" },
  ]}
  events={events}
/>
